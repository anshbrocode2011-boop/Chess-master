# Server port (Render automatically injects PORT in production)
PORT=3000

# Comma-separated list of allowed Netlify frontend origins (or * for open access)
# Example: CORS_ORIGINS=https://your-chess-app.netlify.app,http://localhost:5173
CORS_ORIGINS=*

# Room garbage-collection TTL in milliseconds after both players disconnect (default: 10 minutes)
ROOM_TTL_MS=600000

# Maximum concurrent rooms allowed in memory (keeps RAM well within Render Free Tier 512MB)
MAX_ROOMS=500

# APP_URL: The URL where this service is hosted
APP_URL="MY_APP_URL"
